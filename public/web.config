<?xml version="1.0" encoding="UTF-8"?>
<!-- Configurazione per il server IIS: abilita i tipi di file usati dal sito
     (immagini WebP e manifest) che alcune versioni di IIS non servono di default. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
